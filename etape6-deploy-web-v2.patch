+
+          echo "API_IMAGE=$API_IMAGE" >> "$GITHUB_ENV"
+          echo "WEB_IMAGE=$WEB_IMAGE" >> "$GITHUB_ENV"
+
+      - name: Noter les révisions actuelles (pour un retour arrière)
         run: |
-          PREVIOUS=$(gcloud run services describe "$SERVICE" \
+          API_PREVIOUS=$(gcloud run services describe "$API_SERVICE" \
