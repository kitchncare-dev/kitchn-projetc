-      - name: Vérifier le déploiement
+      - name: Vérifier l'API
         run: |
-          URL=$(gcloud run services describe "$SERVICE" \
+          URL=$(gcloud run services describe "$API_SERVICE" \
             --project "$PROJECT_ID" --region "$REGION" \
             --format='value(status.url)')
-          echo "URL : $URL"
+          echo "API : $URL"
           curl -fsS --retry 10 --retry-delay 3 --retry-all-errors "$URL/health"
 
+      - name: Déployer le front web
+        run: |
+          gcloud run services update "$WEB_SERVICE" \
+            --image "$WEB_IMAGE" \
+            --project "$PROJECT_ID" --region "$REGION"
+          gcloud run services update-traffic "$WEB_SERVICE" --to-latest \
+            --project "$PROJECT_ID" --region "$REGION"
+
+      - name: Vérifier le front web
+        run: |
+          URL=$(gcloud run services describe "$WEB_SERVICE" \
+            --project "$PROJECT_ID" --region "$REGION" \
+            --format='value(status.url)')
+          echo "Web : $URL"
+          curl -fsS --retry 10 --retry-delay 3 --retry-all-errors "$URL/api/health"
+
+      - name: Résumé du déploiement
+        run: |
+          {
+            echo "### Déploiement ${{ github.ref_name }} réussi"
+            echo ""
+            echo "- Commit : \`$GITHUB_SHA\`"
+            echo "- API : $(gcloud run services describe "$API_SERVICE" --project "$PROJECT_ID" --region "$REGION" --format='value(status.url)')"
+            echo "- Web : $(gcloud run services describe "$WEB_SERVICE" --project "$PROJECT_ID" --region "$REGION" --format='value(status.url)')"
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      # Si une étape échoue, on remet les DEUX services sur leur révision précédente,
+      # pour retrouver le dernier couple api + web qui fonctionnait.
       - name: Retour arrière automatique si échec
         if: failure()
         run: |
-          if [ -n "$PREVIOUS" ]; then
-            echo "Retour à la révision $PREVIOUS"
-            gcloud run services update-traffic "$SERVICE" \
-              --to-revisions "$PREVIOUS=100" \
-              --project "$PROJECT_ID" --region "$REGION"
-          fi
+          for pair in "$API_SERVICE:$API_PREVIOUS" "$WEB_SERVICE:$WEB_PREVIOUS"; do
+            service="${pair%%:*}"
+            previous="${pair#*:}"
+            if [ -n "$previous" ]; then
+              echo "Retour de $service à la révision $previous"
+              gcloud run services update-traffic "$service" \
+                --to-revisions "$previous=100" \
+                --project "$PROJECT_ID" --region "$REGION" \
+                || echo "::error::Retour arrière impossible pour $service"
+            fi
+          done
