             --format='value(status.latestReadyRevisionName)')
-          echo "PREVIOUS=$PREVIOUS" >> "$GITHUB_ENV"
+          echo "API_PREVIOUS=$API_PREVIOUS" >> "$GITHUB_ENV"
+          echo "WEB_PREVIOUS=$WEB_PREVIOUS" >> "$GITHUB_ENV"
+
+      # --- API d'abord, puis le front ---
 
-      - name: Déployer la nouvelle révision
+      - name: Déployer l'API
         run: |
-          gcloud run services update "$SERVICE" \
-            --image "$IMAGE" \
+          gcloud run services update "$API_SERVICE" \
+            --image "$API_IMAGE" \
