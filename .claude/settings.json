{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "MAX_THINKING_TOKENS": "8000",
    "CLAUDE_CODE_MAX_TURNS": "40",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm --cached *)",
      "Bash(git rm -r --cached *)",
      "Bash(git restore *)",
      "Bash(git mv *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git push -u origin ai/*)",
      "Bash(git push origin ai/*)",

      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",

      "Bash(gitleaks *)",

      "Bash(pip install -r apps/api/requirements.txt)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",

      "Bash(npm --prefix apps/web ci)",
      "Bash(npm --prefix apps/web run lint)",
      "Bash(npm --prefix apps/web run build)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm --prefix apps/web install *)",
      "Bash(pip install *)",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/gha-creds-*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",

      "Edit(infra/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(**/CLAUDE.md)",
      "Edit(docs/produit/**)",

      "Bash(terraform *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(kubectl *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --delete *)",
      "Bash(git push * dev)",
      "Bash(git push * main)",
      "Bash(git push *:dev)",
      "Bash(git push *:main)",
      "Bash(git push *refs/heads/dev*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push origin HEAD*)",
      "Bash(git reset --hard *)",

      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",

      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
